# 複製這份檔案為 .env.local 並填入實際值（.env.local 已被 .gitignore 排除，不會進版控）

# --- 聯絡表單寄信（lib/forms/leadSink.ts） ---
# Resend API Key，https://resend.com/api-keys
RESEND_API_KEY=
# 收件信箱，商機提案表單送出後寄送到這裡
CONTACT_INBOX_EMAIL=

# --- Google Analytics 4 ---
# Measurement ID，格式 G-XXXXXXXXXX，GA4 後台「資料串流」內可查
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Meta Pixel ---
# Pixel ID（純數字），Meta 事件管理工具內可查
NEXT_PUBLIC_META_PIXEL_ID=

# --- reCAPTCHA（尚未串接，僅預留欄位；目前表單防護僅靠 honeypot） ---
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
